# Copy to .env and adjust. Every value shown is the built-in default.
# Load it with:  uvicorn app.main:app --env-file .env
#           or:  docker run --env-file .env ...

# --- API / security ---
# Comma-separated keys accepted in the X-API-Key header. Change for any real deployment.
API_KEYS=dev-local-key
# Requests allowed per key per window (sliding window).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Uploads ---
# 200 MB
MAX_UPLOAD_BYTES=209715200
ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.mp4

# --- Transcription ---
# mock = deterministic fake (no model download); whisper = real transcription
# (needs requirements-whisper.txt, or the image built with INSTALL_WHISPER=true).
TRANSCRIPTION_ENGINE=mock
# tiny | base | small | medium | large: bigger is more accurate and slower.
WHISPER_MODEL=base
SAMPLE_RATE=16000

# --- Long audio ---
# Files longer than the threshold are split into overlapping chunks.
CHUNK_THRESHOLD_SECONDS=300
CHUNK_LENGTH_SECONDS=240
CHUNK_OVERLAP_SECONDS=5
MAX_CONCURRENT_CHUNK_TRANSCRIPTIONS=2

# --- Workers / retries ---
WORKER_COUNT=1
# Retries after the first attempt (so up to MAX_RETRIES + 1 attempts in total).
MAX_RETRIES=3
# Backoff before retry n: base * 2^(n-1) seconds.
RETRY_BACKOFF_BASE_SECONDS=2

# --- Storage ---
# Audio, transcripts, the SQLite database and dead-letter records live under here.
STORAGE_DIR=storage
# Transcripts longer than this (JSON characters) are stored as files, not inline.
INLINE_TRANSCRIPT_MAX_CHARS=20000
# Optional overrides (default to subdirectories of STORAGE_DIR):
# AUDIO_DIR=storage/audio
# TRANSCRIPT_DIR=storage/transcripts
# DEAD_LETTER_DIR=storage/dead_letter
# DB_PATH=storage/jobs.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (for log aggregators) | text (for reading locally)
LOG_FORMAT=json
